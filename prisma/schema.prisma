generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  FLAT
  KOTHI
  PLOT_LAND
  OFFICE
  SHOP
  CAFE_RESTAURANT
  INDUSTRIAL
  PG
  OTHER
}

enum Purpose {
  SALE
  RENT
  LEASE
}

enum ListingStatus {
  ACTIVE
  CLOSED
}

enum EnquiryWant {
  BUY
  SELL
  RENT
  LEASE
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Listing {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  sector       String
  propertyType PropertyType
  purpose      Purpose
  price        String?
  size         String?
  description  String
  photos       String[]      @default([])
  status       ListingStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sector])
  @@index([status, propertyType])
  @@index([status, createdAt])
}

model Enquiry {
  id           String        @id @default(cuid())
  name         String
  phone        String
  want         EnquiryWant   @default(OTHER)
  propertyType String
  sectorArea   String
  message      String?
  sourcePage   String
  listingSlug  String?
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  @@index([status, createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
